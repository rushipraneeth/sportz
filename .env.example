PORT=8000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sportz
API_SPORTS_KEY=your_api_sports_key_here
API_SPORTS_FOOTBALL_DOMAIN=v3.football.api-sports.io
API_SPORTS_BASKETBALL_DOMAIN=v1.basketball.api-sports.io
API_SPORTS_HOCKEY_DOMAIN=v1.hockey.api-sports.io
API_SPORTS_VOLLEYBALL_DOMAIN=v1.volleyball.api-sports.io
POLLING_INTERVAL_MS=60000
POLLING_IDLE_INTERVAL_MS=180000
MATCH_CACHE_TTL_MS=60000
ARCJET_KEY=your_arcjet_key_optional
ARCJET_MODE=DRY_RUN
FRONTEND_URL=http://localhost:5173
